# ============================================================
# Nethcare Management System — Environment Variables Template
# Copy this file to .env or set these in your hosting environment.
# NEVER commit your actual .env file or credentials to git!
# ============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USER=nethcare_user
DB_PASS=nethcare_pass
DB_URL=jdbc:mysql://localhost:3307/nethcare?useSSL=false&serverTimezone=Asia/Colombo&allowPublicKeyRetrieval=true&autoReconnect=true&tcpKeepAlive=true

# Initial Seed Passwords (Development)
SEED_ADMIN_PASSWORD=admin123
SEED_OPTICIAN_PASSWORD=optician123
SEED_STAFF_PASSWORD=staff123
SEED_SURGEON_PASSWORD=surgeon123
SEED_PATIENT_PASSWORD=patient123
SEED_AUDITOR_PASSWORD=auditor123

# SMS Gateway Configuration
# Options: simulator, notifylk
SMS_PROVIDER=simulator
NOTIFYLK_ENDPOINT=https://app.notify.lk/api/v1/send
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

# Email Gateway Configuration
# Options: simulator, brevo
EMAIL_PROVIDER=simulator
EMAIL_FROM=no-reply@nethcare.lk
BREVO_ENDPOINT=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nethcare.lk
BREVO_SENDER_NAME=Nethcare Clinic
